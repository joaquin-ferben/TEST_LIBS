<?xml version="1.0" encoding="UTF-8"?>
<panel>
 <properties>
  <prop name="Name">
   <prop name="en_US.utf8">iot_engcore_dialogo</prop>
   <prop name="es_ES.utf8">iot_engcore_dialogo</prop>
  </prop>
  <prop name="Size">640 360</prop>
  <prop name="BackColor">_3DFace</prop>
  <prop name="RefPoint">0 0</prop>
  <prop name="InitAndTermRef">True</prop>
  <prop name="SendClick">False</prop>
  <prop name="RefFileName"></prop>
  <prop name="layoutType">None</prop>
 </properties>
 <events>
  <script name="ScopeLib" isEscaped="1"><![CDATA[#uses &quot;iot/engcore/iot_engcore_comun&quot;]]></script>
  <script name="Initialize" isEscaped="1"><![CDATA[// Diálogo de la extensión del Script Editor (engcore). El contenido llega por variables globales del manager.
main()
{
  string texto = getVariable(IOT_ENGCORE_VAR_TEXTO);
  string lista = getVariable(IOT_ENGCORE_VAR_LISTA);
  bool confirmar = getVariable(IOT_ENGCORE_VAR_MODO) == IOT_ENGCORE_MODO_CONFIRMAR;

  txt_contenido.textFormat(&quot;PlainText&quot;);
  setValue(&quot;txt_contenido&quot;, &quot;text&quot;, lista == &quot;&quot; ? texto : texto + &quot;\n\n&quot; + lista);
  setValue(&quot;btn_si&quot;, &quot;visible&quot;, confirmar, &quot;text&quot;, getCatStr(IOT_ENGCORE_CATALOGO, &quot;botonSi&quot;));
  setValue(&quot;btn_no&quot;, &quot;visible&quot;, confirmar, &quot;text&quot;, getCatStr(IOT_ENGCORE_CATALOGO, &quot;botonNo&quot;));
  setValue(&quot;btn_aceptar&quot;, &quot;visible&quot;, !confirmar, &quot;text&quot;, getCatStr(IOT_ENGCORE_CATALOGO, &quot;botonAceptar&quot;));
}]]></script>
 </events>
